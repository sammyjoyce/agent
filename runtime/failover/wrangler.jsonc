{
  "name": "beep-boop-authority",
  "main": "../src/failover/authority-worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "AUTHORITY", "class_name": "CoordinatorAuthority" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoordinatorAuthority"] }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "beep-boop-authority" }]
}
