#include "Shared.xcconfig"
CODE_SIGN_ENTITLEMENTS = AgentApp/Agent.entitlements
// CarPlay shows only an app signed with Apple's grant of the voice-based conversation
// entitlement and a manual profile that carries it, so a device build asks for both only when
// AGENT_CARPLAY is YES.
AGENT_CARPLAY = NO
AGENT_ENTITLEMENTS_NO = AgentApp/Agent.entitlements
AGENT_ENTITLEMENTS_YES = AgentApp/AgentCarPlay.entitlements
AGENT_SIGNING_NO = Automatic
AGENT_SIGNING_YES = Manual
AGENT_PROFILE_YES = $(AGENT_CARPLAY_PROFILE)
CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] = $(AGENT_ENTITLEMENTS_$(AGENT_CARPLAY))
CODE_SIGN_STYLE[sdk=iphoneos*] = $(AGENT_SIGNING_$(AGENT_CARPLAY))
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = $(AGENT_PROFILE_$(AGENT_CARPLAY))
APS_ENVIRONMENT = development
APS_ENVIRONMENT[config=Release] = production
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = AgentApp/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Beep Boop
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Connect to your coordinator through your private Tailscale network.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Dictate messages on this iPhone and in CarPlay, and narrate Scrawl recordings. Dictation audio never leaves the iPhone.
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
PRODUCT_BUNDLE_IDENTIFIER = $(AGENT_BUNDLE_IDENTIFIER)
PRODUCT_NAME = $(TARGET_NAME)
#include? "CarPlay.local.xcconfig"
